<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeerCrypt.ViewModels"
        xmlns:converters="using:DeerCrypt.Converters"
        xmlns:svc="using:DeerCrypt.Services"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:vv="using:DeerCrypt.ViewModels.Viewers"
        xmlns:views="using:DeerCrypt.Views"
        x:Class="DeerCrypt.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="1180"
        Height="720"
        MinWidth="820"
        MinHeight="520">

    <Design.DataContext>
        <vm:MainViewModel IsVaultOpen="False" />
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+L"       Command="{Binding LockVaultCommand}" />
        <KeyBinding Gesture="F2"           Command="{Binding VaultBrowser.RenameCommand}" />
        <KeyBinding Gesture="Delete"       Command="{Binding VaultBrowser.DeleteCommand}" />
        <KeyBinding Gesture="Alt+Left"     Command="{Binding VaultBrowser.NavigateBackCommand}" />
        <KeyBinding Gesture="Alt+Right"    Command="{Binding VaultBrowser.NavigateForwardCommand}" />
        <KeyBinding Gesture="Alt+Up"       Command="{Binding VaultBrowser.NavigateUpCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding VaultBrowser.NewFolderCommand}" />
        <KeyBinding Gesture="Ctrl+O"       Command="{Binding VaultBrowser.AddFilesCommand}" />
        <KeyBinding Gesture="Ctrl+D1"      Command="{Binding VaultBrowser.SetViewModeCommand}" CommandParameter="List" />
        <KeyBinding Gesture="Ctrl+D2"      Command="{Binding VaultBrowser.SetViewModeCommand}" CommandParameter="Grid" />
        <KeyBinding Gesture="Ctrl+I"       Command="{Binding VaultBrowser.ToggleInspectorCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+H" Command="{Binding VaultBrowser.ToggleThumbnailPrivacyCommand}" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding VaultBrowser.OpenSettingsCommand}" />
        <KeyBinding Gesture="Ctrl+W"       Command="{Binding VaultBrowser.CloseActiveDocumentCommand}" />
        <KeyBinding Gesture="Ctrl+Tab"     Command="{Binding VaultBrowser.CycleTabsCommand}" CommandParameter="Forward" />
        <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding VaultBrowser.CycleTabsCommand}" CommandParameter="Back" />
    </Window.KeyBindings>

    <Window.Styles>

        <!-- List rows -->
        <Style Selector="ListBox#FileList">
            <Setter Property="ItemTemplate">
                <DataTemplate x:DataType="vm:VaultItemViewModel">
                    <Grid ColumnDefinitions="30,*,Auto,Auto,Auto"
                          Margin="{DynamicResource ListRowPadding}"
                          Background="Transparent">

                        <!-- Icon, with a small lock badge while the file is open externally -->
                        <Panel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <ic:SymbolIcon Symbol="{Binding Icon}"
                                           IconVariant="Filled"
                                           FontSize="18"
                                           Foreground="{Binding IconBrush}" />
                            <Border IsVisible="{Binding IsCheckedOut}"
                                    Background="{DynamicResource AppBackgroundBrush}"
                                    CornerRadius="6"
                                    Width="12" Height="12"
                                    Margin="10,10,-4,-4"
                                    ToolTip.Tip="Open in another app">
                                <ic:SymbolIcon Symbol="LockClosed" FontSize="10"
                                               Foreground="{DynamicResource WarningBrush}" />
                            </Border>
                        </Panel>

                        <!-- Name (or inline rename box) -->
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="1"
                                    IsVisible="{Binding !IsRenaming}">
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SubText}"
                                       Classes="caption"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding HasSubText}" />
                        </StackPanel>
                        <TextBox Grid.Column="1"
                                 Text="{Binding EditingName}"
                                 IsVisible="{Binding IsRenaming}"
                                 Padding="4,2"
                                 MinHeight="26"
                                 VerticalAlignment="Center"
                                 GotFocus="OnRenameBoxGotFocus"
                                 LostFocus="OnRenameBoxLostFocus" />

                        <TextBlock Grid.Column="2" Text="{Binding TypeText}" Classes="secondary"
                                   Width="{Binding $parent[ListBox].((vm:VaultBrowserViewModel)DataContext).TypeColumnWidth}" Padding="12,0,8,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" Classes="secondary"
                                   Width="{Binding $parent[ListBox].((vm:VaultBrowserViewModel)DataContext).SizeColumnWidth}" Padding="8,0,0,0" TextAlignment="Right"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="4" Text="{Binding DateText}" Classes="secondary"
                                   Width="{Binding $parent[ListBox].((vm:VaultBrowserViewModel)DataContext).DateColumnWidth}" Padding="8,0,0,0" TextAlignment="Right"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                        <!-- Drop-target highlight -->
                        <Border Grid.Column="0" Grid.ColumnSpan="5"
                                Margin="-6,-4"
                                CornerRadius="{StaticResource RadiusSmall}"
                                BorderThickness="1.5"
                                BorderBrush="{DynamicResource AccentBrush}"
                                Background="{DynamicResource DropTargetBrush}"
                                IsVisible="{Binding IsDragTarget}"
                                IsHitTestVisible="False" />
                    </Grid>
                </DataTemplate>
            </Setter>
        </Style>

        <!-- Grid tiles -->
        <Style Selector="ListBox#FileList.grid">
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <views:VirtualizingWrapPanel />
                </ItemsPanelTemplate>
            </Setter>
            <Setter Property="ItemTemplate">
                <DataTemplate x:DataType="vm:VaultItemViewModel">
                    <Panel Width="{DynamicResource GridTileWidth}"
                           Height="{DynamicResource GridTileHeight}"
                           Background="Transparent"
                           ToolTip.Tip="{Binding DisplayName}">
                        <StackPanel VerticalAlignment="Center" Spacing="6" Margin="8">
                            <Panel HorizontalAlignment="Center" Height="{DynamicResource GridThumbHeight}">
                                <ic:SymbolIcon Symbol="{Binding Icon}"
                                               IconVariant="Filled"
                                               FontSize="44"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding IconBrush}">
                                    <ic:SymbolIcon.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                            <Binding Path="!HasThumbnail" />
                                            <Binding Path="!$parent[ListBox].((vm:VaultBrowserViewModel)DataContext).ShowThumbnails" />
                                        </MultiBinding>
                                    </ic:SymbolIcon.IsVisible>
                                </ic:SymbolIcon>
                                <!-- Thumbnail: clipped to a rounded frame so the privacy blur stays inside it -->
                                <Border CornerRadius="{StaticResource RadiusSmall}" ClipToBounds="True"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="HasThumbnail" />
                                            <Binding Path="$parent[ListBox].((vm:VaultBrowserViewModel)DataContext).ShowThumbnails" />
                                        </MultiBinding>
                                    </Border.IsVisible>
                                    <Image Classes="thumb" Source="{Binding Thumbnail}" Stretch="Uniform"
                                           MaxHeight="{DynamicResource GridThumbHeight}" />
                                </Border>
                                <Border IsVisible="{Binding IsCheckedOut}"
                                        Background="{DynamicResource AppBackgroundBrush}"
                                        CornerRadius="8" Width="16" Height="16"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,-4,-2">
                                    <ic:SymbolIcon Symbol="LockClosed" FontSize="12"
                                                   Foreground="{DynamicResource WarningBrush}" />
                                </Border>
                            </Panel>
                            <TextBlock Text="{Binding DisplayName}"
                                       IsVisible="{Binding !IsRenaming}"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBox Text="{Binding EditingName}"
                                     IsVisible="{Binding IsRenaming}"
                                     FontSize="12"
                                     Padding="4,2"
                                     MinHeight="24"
                                     GotFocus="OnRenameBoxGotFocus"
                                     LostFocus="OnRenameBoxLostFocus" />
                            <TextBlock Text="{Binding TileDetailText}"
                                       Classes="caption"
                                       TextAlignment="Center"
                                       IsVisible="{Binding !IsRenaming}" />
                        </StackPanel>
                        <Border CornerRadius="{StaticResource RadiusSmall}"
                                BorderThickness="1.5"
                                BorderBrush="{DynamicResource AccentBrush}"
                                Background="{DynamicResource DropTargetBrush}"
                                IsVisible="{Binding IsDragTarget}"
                                IsHitTestVisible="False" />
                    </Panel>
                </DataTemplate>
            </Setter>
        </Style>

        <!-- Blurred-until-hover thumbnails (privacy) -->
        <Style Selector="ListBox#FileList.blurthumbs Image.thumb">
            <Setter Property="Effect" Value="blur(22)" />
        </Style>
        <Style Selector="ListBox#FileList.blurthumbs ListBoxItem:pointerover Image.thumb">
            <Setter Property="Effect" Value="{x:Null}" />
        </Style>
        <Style Selector="Border.inspector-preview Image.thumb.blur">
            <Setter Property="Effect" Value="blur(24)" />
        </Style>
        <Style Selector="Border.inspector-preview:pointerover Image.thumb.blur">
            <Setter Property="Effect" Value="{x:Null}" />
        </Style>

        <!-- Previous results stay visible but dimmed while a slow load is in flight -->
        <Style Selector="ListBox#FileList.loading">
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <!-- Keep folder tree expansion in sync with the view model -->
        <Style Selector="TreeView#FolderTree TreeViewItem" x:DataType="vm:DirectoryNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>

        <!-- Document tabs -->
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7,7,0,0" />
            <Setter Property="Padding" Value="12,7,8,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.tab.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0,2,0,0" />
        </Style>
        <Style Selector="Button.tab-close">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="Button.tab-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- Column resize handle: a thin grabbable strip on a header cell's left edge -->
        <Style Selector="Thumb.column-resizer">
            <Setter Property="Width" Value="8" />
            <Setter Property="Margin" Value="-4,4,0,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="SizeWestEast" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <Rectangle Width="1" Fill="{DynamicResource HairlineStrongBrush}" HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Thumb.column-resizer:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>

        <!-- Toggle-style ghost buttons (details panel) -->
        <Style Selector="Button.ghost.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- Activity state icon colors -->
        <Style Selector="ic|SymbolIcon.activity-state">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="ic|SymbolIcon.activity-state.running">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ic|SymbolIcon.activity-state.ok">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="ic|SymbolIcon.activity-state.bad">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>

        <!-- Segmented list/grid switch -->
        <Style Selector="Border.segmented Button.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </Window.Styles>

    <Panel>

        <!-- ═══════════════ Welcome / no vault open ═══════════════ -->
        <Panel x:Name="WelcomeRoot"
               IsVisible="{Binding !IsVaultOpen}"
               Background="{DynamicResource AppBackgroundBrush}"
               DragDrop.AllowDrop="True">

            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="460"
                            Margin="32,48">

                    <Border Width="68" Height="68"
                            CornerRadius="18"
                            Background="{DynamicResource SelectedBrush}"
                            HorizontalAlignment="Center">
                        <ic:SymbolIcon Symbol="ShieldLock" FontSize="34"
                                       Foreground="{DynamicResource AccentBrush}" />
                    </Border>

                    <TextBlock Text="DeerCrypt"
                               FontSize="26"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,0" />
                    <TextBlock Text="Encrypted vaults for your files."
                               Classes="secondary"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0" />
                    <TextBlock Text="Nothing leaves a vault unless you extract it."
                               Classes="muted"
                               FontSize="12.5"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Margin="0,24,0,0">
                        <Button Classes="primary" Command="{Binding NewVaultCommand}" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:SymbolIcon Symbol="Add" />
                                <TextBlock Text="Create vault" />
                            </StackPanel>
                        </Button>
                        <Button Classes="secondary" Command="{Binding OpenVaultCommand}" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:SymbolIcon Symbol="FolderOpen" />
                                <TextBlock Text="Open vault" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Recent vaults -->
                    <StackPanel IsVisible="{Binding HasRecentVaults}" Margin="0,36,0,0">
                        <TextBlock Text="Recent vaults" Classes="section" Margin="2,0,0,8" />
                        <Border Classes="card" Padding="4">
                            <ItemsControl ItemsSource="{Binding RecentVaults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="svc:RecentVaultEntry">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Button Grid.Column="0"
                                                    Classes="ghost"
                                                    Padding="10,8"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenRecentCommand}"
                                                    CommandParameter="{Binding Path}">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Grid.Column="0" Width="32" Height="32"
                                                            CornerRadius="8"
                                                            Background="{DynamicResource SurfaceSunkenBrush}"
                                                            Margin="0,0,12,0">
                                                        <ic:SymbolIcon Symbol="LockClosed"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Path}"
                                                                   Classes="caption"
                                                                   TextTrimming="PrefixCharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding LastOpened, StringFormat='{}{0:MMM d, yyyy}'}"
                                                               Classes="caption"
                                                               VerticalAlignment="Center"
                                                               Margin="12,0,0,0" />
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Classes="ghost icon"
                                                    VerticalAlignment="Center"
                                                    Margin="2,0,4,0"
                                                    ToolTip.Tip="Remove from list"
                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveRecentCommand}"
                                                    CommandParameter="{Binding Path}">
                                                <ic:SymbolIcon Symbol="Dismiss" FontSize="14" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="You can also drop a .dcv vault file here to open it."
                               Classes="caption"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- Shown while a vault file is dragged over the window -->
            <Border x:Name="WelcomeDropOverlay"
                    IsVisible="False"
                    IsHitTestVisible="False"
                    Margin="16"
                    CornerRadius="{StaticResource RadiusLarge}"
                    BorderThickness="2"
                    BorderBrush="{DynamicResource AccentBrush}"
                    Background="{DynamicResource DropTargetBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <ic:SymbolIcon Symbol="ShieldLock" FontSize="36" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Drop to open this vault" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Panel>

        <!-- ═══════════════ Vault open ═══════════════ -->
        <Grid IsVisible="{Binding IsVaultOpen}" RowDefinitions="Auto,*">

            <!-- Header -->
            <Border Grid.Row="0"
                    Classes="divider-bottom"
                    Background="{DynamicResource ChromeBackgroundBrush}"
                    Padding="12,8">
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <!-- Vault identity -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="7"
                                Background="{DynamicResource SelectedBrush}">
                            <ic:SymbolIcon Symbol="ShieldLock" FontSize="16"
                                           Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="{Binding VaultName}" FontWeight="SemiBold"
                                       MaxWidth="220" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Unlocked" Classes="caption" FontSize="11" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Search -->
                    <TextBox Grid.Column="1"
                             x:Name="SearchBox"
                             Classes="search"
                             MaxWidth="520"
                             Margin="24,0"
                             Text="{Binding VaultBrowser.SearchText}"
                             Watermark="{Binding VaultBrowser.SearchWatermark, FallbackValue='Search the whole vault'}">
                        <TextBox.InnerLeftContent>
                            <ic:SymbolIcon Symbol="Search" Margin="10,0,2,0"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                        </TextBox.InnerLeftContent>
                        <TextBox.InnerRightContent>
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,6,0">
                                <!-- Scope: whole vault or the current folder -->
                                <Button Classes="ghost" Padding="6,2"
                                        Classes.selected="{Binding VaultBrowser.SearchInFolder}"
                                        Command="{Binding VaultBrowser.ToggleSearchScopeCommand}"
                                        ToolTip.Tip="Search the whole vault, or only the folder you're in (and its subfolders)">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <ic:SymbolIcon Symbol="Folder" FontSize="12" IsVisible="{Binding VaultBrowser.SearchInFolder}" />
                                        <ic:SymbolIcon Symbol="ShieldLock" FontSize="12" IsVisible="{Binding !VaultBrowser.SearchInFolder}" />
                                        <TextBlock Text="{Binding VaultBrowser.SearchScopeText}" FontSize="11.5" MaxWidth="120"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Panel VerticalAlignment="Center">
                                <TextBlock Text="Ctrl K"
                                           Classes="caption"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding !VaultBrowser.IsSearchActive}" />
                                <Button Classes="ghost"
                                        Padding="4"
                                        IsVisible="{Binding VaultBrowser.IsSearchActive}"
                                        Command="{Binding VaultBrowser.ClearSearchCommand}"
                                        ToolTip.Tip="Clear search">
                                    <ic:SymbolIcon Symbol="Dismiss" FontSize="12" />
                                </Button>
                                </Panel>
                            </StackPanel>
                        </TextBox.InnerRightContent>
                    </TextBox>

                    <!-- Settings + lock -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="ghost icon" ToolTip.Tip="Settings and tools">
                            <ic:SymbolIcon Symbol="Settings" FontSize="18" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="Settings" Command="{Binding VaultBrowser.OpenSettingsCommand}" InputGesture="Ctrl+OemComma">
                                        <MenuItem.Icon><ic:SymbolIcon Symbol="Settings" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Hide thumbnails" ToggleType="CheckBox"
                                              IsVisible="{Binding VaultBrowser.ThumbnailsEnabled, FallbackValue=False}"
                                              IsChecked="{Binding VaultBrowser.ThumbnailsHidden, Mode=OneWay, FallbackValue=False}"
                                              Command="{Binding VaultBrowser.ToggleThumbnailPrivacyCommand}"
                                              InputGesture="Ctrl+Shift+H" />
                                    <Separator />
                                    <MenuItem Header="Compact vault…" Command="{Binding VaultBrowser.CompactCommand}">
                                        <MenuItem.Icon><ic:SymbolIcon Symbol="Broom" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Check integrity…" Command="{Binding VaultBrowser.CheckIntegrityCommand}">
                                        <MenuItem.Icon><ic:SymbolIcon Symbol="ShieldCheckmark" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Lock and open another vault…" Command="{Binding OpenVaultCommand}">
                                        <MenuItem.Icon><ic:SymbolIcon Symbol="FolderOpen" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Lock and create a vault…" Command="{Binding NewVaultCommand}">
                                        <MenuItem.Icon><ic:SymbolIcon Symbol="Add" /></MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button Classes="ghost"
                                Command="{Binding LockVaultCommand}"
                                ToolTip.Tip="Lock the vault (Ctrl+L)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="LockClosed" />
                                <TextBlock Text="Lock" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body: sidebar | splitter | content -->
            <Grid Grid.Row="1"
                  x:Name="BodyGrid"
                  x:DataType="vm:VaultBrowserViewModel"
                  DataContext="{Binding VaultBrowser}"
                  ColumnDefinitions="232,Auto,*">

                <!-- Sidebar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource ChromeBackgroundBrush}"
                        BorderBrush="{DynamicResource HairlineBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="*,Auto">

                        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,8,0,8">

                                <ItemsControl ItemsSource="{Binding PrimaryNav}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SidebarItem">
                                            <Button Classes="nav"
                                                    Classes.active="{Binding IsActive}"
                                                    Command="{Binding $parent[ItemsControl].((vm:VaultBrowserViewModel)DataContext).NavigateSidebarCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <ic:SymbolIcon Symbol="{Binding Icon}" />
                                                    <TextBlock Text="{Binding Label}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Library" Classes="section" />
                                <ItemsControl ItemsSource="{Binding LibraryNav}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SidebarItem">
                                            <Button Classes="nav"
                                                    Classes.active="{Binding IsActive}"
                                                    Command="{Binding $parent[ItemsControl].((vm:VaultBrowserViewModel)DataContext).NavigateSidebarCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <ic:SymbolIcon Symbol="{Binding Icon}" />
                                                    <TextBlock Text="{Binding Label}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Folders" Classes="section" />
                                <TreeView x:Name="FolderTree"
                                          Classes="folders"
                                          ItemsSource="{Binding FolderNodes}"
                                          SelectedItem="{Binding SelectedTreeNode, Mode=TwoWay}"
                                          DragDrop.AllowDrop="True">
                                    <TreeView.ItemTemplate>
                                        <TreeDataTemplate x:DataType="vm:DirectoryNodeViewModel"
                                                          ItemsSource="{Binding Children}">
                                            <Border Background="{Binding IsDropTarget,
                                                        Converter={x:Static converters:BoolToHighlightConverter.Instance}}"
                                                    CornerRadius="{StaticResource RadiusSmall}"
                                                    Padding="2,0">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <ic:SymbolIcon Symbol="Folder" IconVariant="Filled"
                                                                   Foreground="#E0A93B" />
                                                    <TextBlock Text="{Binding Name}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </TreeDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Storage summary -->
                        <Border Grid.Row="1" Classes="divider-top" Padding="14,12">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ic:SymbolIcon Symbol="Storage" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding StorageSummaryText}" Classes="secondary" FontSize="12"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding StorageDetailText}" Classes="caption"
                                           TextWrapping="Wrap" />
                                <Button Classes="ghost"
                                        Padding="0,2"
                                        HorizontalAlignment="Left"
                                        IsVisible="{Binding HasReclaimableSpace}"
                                        Command="{Binding CompactCommand}"
                                        Foreground="{DynamicResource AccentBrush}">
                                    <TextBlock Text="Compact to reclaim space" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1"
                              x:Name="SidebarSplitter"
                              Classes="sidebar"
                              ResizeDirection="Columns" />

                <!-- Content -->
                <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">

                    <!-- ═══ Tabs: Files + open documents ═══ -->
                    <Border Grid.Row="0" IsVisible="{Binding HasDocuments}"
                            Background="{DynamicResource ChromeBackgroundBrush}"
                            Classes="divider-bottom" Padding="6,5,6,0">
                        <!-- No scroll bar over the tabs: the wheel scrolls them sideways and the
                             active tab is always brought into view -->
                        <ScrollViewer x:Name="TabScroller"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="2" x:Name="TabStrip">
                                <Button Classes="tab" Classes.active="{Binding IsBrowserActive}"
                                        Command="{Binding ShowBrowserCommand}" ToolTip.Tip="Files (Ctrl+Tab cycles tabs)">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,4,0">
                                        <ic:SymbolIcon Symbol="Folder" IconVariant="Filled" Foreground="#E0A93B" />
                                        <TextBlock Text="Files" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <ItemsControl ItemsSource="{Binding Documents}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vv:DocumentViewModel">
                                            <Button Classes="tab" Classes.active="{Binding IsActive}"
                                                    Command="{Binding $parent[ItemsControl].((vm:VaultBrowserViewModel)DataContext).ActivateDocumentCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{Binding Title}">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Pop out into a window" Tag="popout" Click="OnTabMenuClick">
                                                            <MenuItem.Icon><ic:SymbolIcon Symbol="WindowNew" /></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Show in folder" Tag="reveal" Click="OnTabMenuClick">
                                                            <MenuItem.Icon><ic:SymbolIcon Symbol="FolderOpen" /></MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem Header="Close" Tag="close" Click="OnTabMenuClick" InputGesture="Ctrl+W">
                                                            <MenuItem.Icon><ic:SymbolIcon Symbol="Dismiss" /></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Close other tabs" Tag="others" Click="OnTabMenuClick" />
                                                        <MenuItem Header="Close all tabs" Tag="all" Click="OnTabMenuClick" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <ic:SymbolIcon Symbol="{Binding Icon}" IconVariant="Filled" Foreground="{Binding IconBrush}" />
                                                    <TextBlock Text="{Binding Title}" MaxWidth="200" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <ic:SymbolIcon Symbol="Speaker2" FontSize="13" Foreground="{DynamicResource AccentBrush}"
                                                                   IsVisible="{Binding HasBackgroundActivity}" ToolTip.Tip="Playing" />
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                                             IsVisible="{Binding IsDirty}" ToolTip.Tip="Unsaved changes" />
                                                    <Button Classes="tab-close" ToolTip.Tip="Close (Ctrl+W)"
                                                            Command="{Binding $parent[ItemsControl].((vm:VaultBrowserViewModel)DataContext).CloseDocumentCommand}"
                                                            CommandParameter="{Binding}">
                                                        <ic:SymbolIcon Symbol="Dismiss" FontSize="11" />
                                                    </Button>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Panel Grid.Row="1">
                    <!-- ═══ Files (browser) ═══ -->
                    <Grid x:Name="BrowserPane" IsVisible="{Binding IsBrowserActive}"
                          RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,Auto">

                    <!-- Toolbar: navigation, location, actions -->
                    <Border Grid.Row="0"
                            Grid.ColumnSpan="2"
                            x:Name="NavBar"
                            Classes="divider-bottom"
                            Padding="10,8"
                            DragDrop.AllowDrop="True">
                        <Grid ColumnDefinitions="Auto,*,Auto">

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" Margin="0,0,8,0">
                                <Button Classes="ghost icon" Command="{Binding NavigateBackCommand}" ToolTip.Tip="Back (Alt+Left)">
                                    <ic:SymbolIcon Symbol="ArrowLeft" />
                                </Button>
                                <Button Classes="ghost icon" Command="{Binding NavigateForwardCommand}" ToolTip.Tip="Forward (Alt+Right)">
                                    <ic:SymbolIcon Symbol="ArrowRight" />
                                </Button>
                                <Button Classes="ghost icon" Command="{Binding NavigateUpCommand}" ToolTip.Tip="Up one folder (Alt+Up)">
                                    <ic:SymbolIcon Symbol="ArrowUp" />
                                </Button>
                            </StackPanel>

                            <!-- Breadcrumb (folders) or view title (library views and search) -->
                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding Breadcrumb}"
                                              IsVisible="{Binding ShowBreadcrumb}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BreadcrumbSegment">
                                            <StackPanel Orientation="Horizontal">
                                                <ic:SymbolIcon Symbol="ChevronRight" FontSize="12"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="2,0"
                                                               IsVisible="{Binding !IsFirst}" />
                                                <Button Classes="ghost"
                                                        Padding="6,3"
                                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                                        Content="{Binding Name}"
                                                        Command="{Binding $parent[ItemsControl].((vm:VaultBrowserViewModel)DataContext).NavigateToBreadcrumbCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Background>
                                                        <MultiBinding Converter="{x:Static converters:EqualsToBrushConverter.Instance}">
                                                            <Binding Path="DirectoryId" />
                                                            <Binding Path="$parent[ItemsControl].((vm:VaultBrowserViewModel)DataContext).BreadcrumbDragTargetId" />
                                                        </MultiBinding>
                                                    </Button.Background>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding ViewTitle}"
                                           Classes="title"
                                           Margin="6,0"
                                           IsVisible="{Binding !ShowBreadcrumb}" />
                            </Panel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">

                                <!-- Actions for the current selection -->
                                <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding HasSelection}">
                                    <Button Classes="ghost icon" Command="{Binding ExtractCommand}" ToolTip.Tip="Extract to disk">
                                        <ic:SymbolIcon Symbol="ArrowDownload" />
                                    </Button>
                                    <Button Classes="ghost icon" Command="{Binding MoveCommand}" ToolTip.Tip="Move to folder">
                                        <ic:SymbolIcon Symbol="FolderArrowRight" />
                                    </Button>
                                    <Button Classes="ghost icon" Command="{Binding RenameCommand}" ToolTip.Tip="Rename (F2)">
                                        <ic:SymbolIcon Symbol="Rename" />
                                    </Button>
                                    <Button Classes="ghost icon" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete (Del)">
                                        <ic:SymbolIcon Symbol="Delete" />
                                    </Button>
                                    <Rectangle Width="1" Margin="6,6" Fill="{DynamicResource HairlineStrongBrush}" />
                                </StackPanel>

                                <Border Classes="segmented" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Classes="ghost icon" Width="30" Height="26"
                                                Classes.selected="{Binding !IsGridView}"
                                                Command="{Binding SetViewModeCommand}" CommandParameter="List"
                                                ToolTip.Tip="List view (Ctrl+1)">
                                            <ic:SymbolIcon Symbol="AppsList" FontSize="15" />
                                        </Button>
                                        <Button Classes="ghost icon" Width="30" Height="26"
                                                Classes.selected="{Binding IsGridView}"
                                                Command="{Binding SetViewModeCommand}" CommandParameter="Grid"
                                                ToolTip.Tip="Grid view (Ctrl+2)">
                                            <ic:SymbolIcon Symbol="Grid" FontSize="15" />
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Button Classes="ghost icon" Command="{Binding NewFolderCommand}"
                                        ToolTip.Tip="New folder (Ctrl+Shift+N)">
                                    <ic:SymbolIcon Symbol="FolderAdd" />
                                </Button>

                                <Button Classes="primary" Margin="4,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ic:SymbolIcon Symbol="Add" />
                                        <TextBlock Text="Add" />
                                        <ic:SymbolIcon Symbol="ChevronDown" FontSize="12" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="Files…" Command="{Binding AddFilesCommand}" InputGesture="Ctrl+O">
                                                <MenuItem.Icon><ic:SymbolIcon Symbol="DocumentAdd" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Folder…" Command="{Binding AddFolderCommand}">
                                                <MenuItem.Icon><ic:SymbolIcon Symbol="FolderAdd" /></MenuItem.Icon>
                                            </MenuItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>

                                <Button Classes="ghost icon" Margin="4,0,0,0"
                                        Classes.selected="{Binding IsInspectorOpen}"
                                        Command="{Binding ToggleInspectorCommand}"
                                        ToolTip.Tip="Details panel (Ctrl+I)">
                                    <ic:SymbolIcon Symbol="PanelRight" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Column headers (list view only) -->
                    <Border Grid.Row="1"
                            Classes="divider-bottom"
                            IsVisible="{Binding !EffectiveGridView}">
                        <Grid ColumnDefinitions="30,*,Auto,Auto,Auto" Margin="16,0,16,0">
                            <Button Grid.Column="1" Classes="columnHeader"
                                    Content="{Binding NameHeaderText}"
                                    Command="{Binding SortByCommand}" CommandParameter="Name"
                                    HorizontalContentAlignment="Left" />
                            <Panel Grid.Column="2" Width="{Binding TypeColumnWidth}">
                                <Button Classes="columnHeader" Content="{Binding TypeHeaderText}"
                                        Command="{Binding SortByCommand}" CommandParameter="Type"
                                        HorizontalContentAlignment="Left" Padding="12,0,8,0" />
                                <Thumb Classes="column-resizer" Tag="Type" />
                            </Panel>
                            <Panel Grid.Column="3" Width="{Binding SizeColumnWidth}">
                                <Button Classes="columnHeader" Content="{Binding SizeHeaderText}"
                                        Command="{Binding SortByCommand}" CommandParameter="Size"
                                        HorizontalContentAlignment="Right" />
                                <Thumb Classes="column-resizer" Tag="Size" />
                            </Panel>
                            <Panel Grid.Column="4" Width="{Binding DateColumnWidth}">
                                <Button Classes="columnHeader" Content="{Binding DateHeaderText}"
                                        Command="{Binding SortByCommand}" CommandParameter="Date"
                                        HorizontalContentAlignment="Right" />
                                <Thumb Classes="column-resizer" Tag="Date" />
                            </Panel>
                        </Grid>
                    </Border>

                    <!-- Items -->
                    <Panel Grid.Row="2">
                        <ListBox x:Name="FileList"
                                 Classes="files"
                                 Classes.grid="{Binding EffectiveGridView}"
                                 Classes.loading="{Binding ShowLoadingBar}"
                                 Classes.blurthumbs="{Binding BlurThumbnails}"
                                 ItemsSource="{Binding CurrentItems}"
                                 SelectedItem="{Binding SelectedFile}"
                                 SelectionMode="Multiple">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open" Command="{Binding OpenCommand}" InputGesture="Enter">
                                        <MenuItem.Icon><ic:SymbolIcon Symbol="Open" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Open in new window" Command="{Binding OpenInNewWindowCommand}" InputGesture="Ctrl+Enter">
                                        <MenuItem.Icon><ic:SymbolIcon Symbol="WindowNew" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Show in folder" Command="{Binding RevealSelectedCommand}"
                                              IsVisible="{Binding !ShowBreadcrumb}">
                                        <MenuItem.Icon><ic:SymbolIcon Symbol="FolderOpen" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Extract…" Command="{Binding ExtractCommand}">
                                        <MenuItem.Icon><ic:SymbolIcon Symbol="ArrowDownload" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Move to…" Command="{Binding MoveCommand}">
                                        <MenuItem.Icon><ic:SymbolIcon Symbol="FolderArrowRight" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Rename" Command="{Binding RenameCommand}" InputGesture="F2">
                                        <MenuItem.Icon><ic:SymbolIcon Symbol="Rename" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Delete" Command="{Binding DeleteCommand}" InputGesture="Delete">
                                        <MenuItem.Icon><ic:SymbolIcon Symbol="Delete" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="New folder" Command="{Binding NewFolderCommand}" InputGesture="Ctrl+Shift+N">
                                        <MenuItem.Icon><ic:SymbolIcon Symbol="FolderAdd" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Add files…" Command="{Binding AddFilesCommand}" InputGesture="Ctrl+O">
                                        <MenuItem.Icon><ic:SymbolIcon Symbol="DocumentAdd" /></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>

                        <!-- Loading: thin bar across the top; the previous list stays (dimmed) until results arrive -->
                        <ProgressBar IsVisible="{Binding ShowLoadingBar}"
                                     IsIndeterminate="True"
                                     Classes="meter"
                                     Height="2" MinHeight="2"
                                     CornerRadius="0"
                                     VerticalAlignment="Top" />

                        <!-- Empty state (doesn't block drops onto the list behind it) -->
                        <StackPanel IsVisible="{Binding IsCurrentViewEmpty}"
                                    IsHitTestVisible="False"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="6"
                                    MaxWidth="320">
                            <ic:SymbolIcon Symbol="FolderOpen" FontSize="40"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding EmptyStateTitle}" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding EmptyStateText}" Classes="secondary"
                                       TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Panel>


                    <!-- ═══ Inspector ═══ -->
                    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1"
                            Width="300"
                            IsVisible="{Binding IsInspectorOpen}"
                            BorderBrush="{DynamicResource HairlineBrush}"
                            BorderThickness="1,0,0,0">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="18,18,18,24" Spacing="16">

                                <!-- Preview: the thumbnail when there is one (and thumbnails are showing), else the icon -->
                                <Border Height="150" Classes="inspector-preview"
                                        CornerRadius="{StaticResource RadiusLarge}"
                                        ClipToBounds="True"
                                        Background="{DynamicResource SurfaceSunkenBrush}">
                                    <Panel>
                                        <ic:SymbolIcon Symbol="{Binding InspectorIcon}"
                                                       IconVariant="Filled"
                                                       FontSize="56"
                                                       Foreground="{Binding InspectorIconBrush}">
                                            <ic:SymbolIcon.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                    <Binding Path="!InspectedItem.HasThumbnail" FallbackValue="True" />
                                                    <Binding Path="!ShowThumbnails" />
                                                </MultiBinding>
                                            </ic:SymbolIcon.IsVisible>
                                        </ic:SymbolIcon>
                                        <Image Classes="thumb" Classes.blur="{Binding BlurThumbnails}"
                                               Source="{Binding InspectedItem.Thumbnail, FallbackValue={x:Null}}"
                                               Stretch="Uniform" Margin="10">
                                            <Image.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="InspectedItem.HasThumbnail" FallbackValue="False" />
                                                    <Binding Path="ShowThumbnails" />
                                                </MultiBinding>
                                            </Image.IsVisible>
                                        </Image>
                                    </Panel>
                                </Border>

                                <StackPanel Spacing="3">
                                    <SelectableTextBlock Text="{Binding InspectorTitle}"
                                                         FontSize="16" FontWeight="SemiBold"
                                                         TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding InspectorSubtitle}" Classes="secondary"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Actions -->
                                <WrapPanel IsVisible="{Binding HasInspectorActions}" ItemSpacing="6" LineSpacing="6">
                                    <Button Classes="primary" Command="{Binding OpenCommand}"
                                            IsVisible="{Binding !IsInspectingMultiple}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <ic:SymbolIcon Symbol="Open" />
                                            <TextBlock Text="Open" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="secondary" Command="{Binding ExtractCommand}"
                                            IsVisible="{Binding IsInspectingMultiple}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <ic:SymbolIcon Symbol="ArrowDownload" />
                                            <TextBlock Text="Extract" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="secondary icon" Command="{Binding ExtractCommand}" ToolTip.Tip="Extract to disk"
                                            IsVisible="{Binding !IsInspectingMultiple}">
                                        <ic:SymbolIcon Symbol="ArrowDownload" />
                                    </Button>
                                    <Button Classes="secondary icon" Command="{Binding MoveCommand}" ToolTip.Tip="Move to folder">
                                        <ic:SymbolIcon Symbol="FolderArrowRight" />
                                    </Button>
                                    <Button Classes="secondary icon" Command="{Binding RenameCommand}" ToolTip.Tip="Rename (F2)"
                                            IsVisible="{Binding !IsInspectingMultiple}">
                                        <ic:SymbolIcon Symbol="Rename" />
                                    </Button>
                                    <Button Classes="secondary icon" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete">
                                        <ic:SymbolIcon Symbol="Delete" Foreground="{DynamicResource DangerBrush}" />
                                    </Button>
                                </WrapPanel>

                                <Rectangle Height="1" Fill="{DynamicResource HairlineBrush}" />

                                <!-- Details -->
                                <ItemsControl ItemsSource="{Binding InspectorRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:InspectorRow">
                                            <Grid ColumnDefinitions="24,*" Margin="0,0,0,12">
                                                <Panel VerticalAlignment="Top" Margin="0,1,0,0">
                                                    <ic:SymbolIcon Symbol="{Binding Icon}" FontSize="15"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   IsVisible="{Binding !HasIconBrush}" />
                                                    <ic:SymbolIcon Symbol="{Binding Icon}" FontSize="15"
                                                                   Foreground="{Binding IconBrush}"
                                                                   IsVisible="{Binding HasIconBrush}" />
                                                </Panel>
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock Text="{Binding Label}" Classes="caption" />
                                                    <SelectableTextBlock Text="{Binding Value}" FontSize="13" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Integrity hash -->
                                <Border Classes="stat" IsVisible="{Binding HasInspectorHash}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="SHA-256 of the original file" Classes="caption" />
                                            <TextBlock Text="{Binding InspectorHashShort}"
                                                       FontFamily="monospace" FontSize="12.5"
                                                       ToolTip.Tip="{Binding InspectorHash}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="ghost icon" VerticalAlignment="Center"
                                                Command="{Binding CopyInspectorHashCommand}" ToolTip.Tip="Copy the full hash">
                                            <ic:SymbolIcon Symbol="Copy" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <Button Classes="ghost" HorizontalAlignment="Left" Padding="0,2"
                                        IsVisible="{Binding CanRevealInspected}"
                                        Command="{Binding RevealInspectedCommand}"
                                        Foreground="{DynamicResource AccentBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ic:SymbolIcon Symbol="FolderOpen" />
                                        <TextBlock Text="Show in folder" />
                                    </StackPanel>
                                </Button>

                                <TextBlock IsVisible="{Binding IsInspectingSummary}"
                                           Text="Select a file or folder to see its details."
                                           Classes="caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    </Grid>

                    <!-- ═══ Open documents: every view stays alive; only the active one is visible ═══ -->
                    <ItemsControl ItemsSource="{Binding Documents}" IsVisible="{Binding !IsBrowserActive}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Panel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vv:DocumentViewModel">
                                <ContentControl Content="{Binding}" IsVisible="{Binding IsActive}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Panel>

                    <!-- ═══ Status bar with activity ═══ -->
                    <Border Grid.Row="2" Classes="divider-top" IsVisible="{Binding ShowStatusBar}" Padding="10,0,14,0" Height="34"
                            Background="{DynamicResource ChromeBackgroundBrush}">
                        <Grid ColumnDefinitions="*,Auto,Auto">

                            <!-- Plain status message when nothing is running -->
                            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Margin="4,0,0,0"
                                       IsVisible="{Binding !Activities.ShowStrip}"
                                       Classes="secondary" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- Featured activity: running, or the one that just finished -->
                            <Panel Grid.Column="0" IsVisible="{Binding Activities.ShowStrip}">
                            <Grid DataContext="{Binding Activities.Current}"
                                  x:DataType="vm:ActivityItem"
                                  ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto"
                                  VerticalAlignment="Center">
                                <ic:SymbolIcon Grid.Column="0" Symbol="{Binding StateIcon}" Margin="4,0,8,0"
                                               Classes="activity-state"
                                               Classes.running="{Binding IsRunning}"
                                               Classes.ok="{Binding IsSucceeded}"
                                               Classes.bad="{Binding IsFailedState}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" MaxWidth="280" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" FontSize="12" Classes="secondary" Margin="10,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Text="{Binding CurrentFileName}" IsVisible="{Binding IsRunning}" />
                                <TextBlock Grid.Column="2" FontSize="12" Classes="secondary" Margin="10,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Text="{Binding ResultText}" IsVisible="{Binding IsFinished}" />
                                <ProgressBar Grid.Column="3" Classes="meter" Width="140" Minimum="0" Maximum="1"
                                             Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}"
                                             IsVisible="{Binding IsRunning}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding PercentText}" FontSize="12" Classes="secondary"
                                           Margin="8,0,0,0" MinWidth="32" VerticalAlignment="Center"
                                           IsVisible="{Binding IsRunning}" />
                                <Button Grid.Column="5" Classes="ghost" Padding="4" Margin="4,0,0,0"
                                        Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}"
                                        ToolTip.Tip="Cancel">
                                    <ic:SymbolIcon Symbol="Dismiss" FontSize="12" />
                                </Button>
                            </Grid>
                            </Panel>

                            <!-- All activity -->
                            <Button Grid.Column="1" Classes="ghost" Padding="8,4" Margin="8,0"
                                    IsVisible="{Binding Activities.HasItems}"
                                    ToolTip.Tip="Activity">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon Symbol="History" FontSize="14" />
                                    <TextBlock Text="Activity" FontSize="12" />
                                    <Border IsVisible="{Binding Activities.HasBadge}"
                                            Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="5,0">
                                        <TextBlock Text="{Binding Activities.BadgeText}" FontSize="11" Foreground="White" />
                                    </Border>
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="TopEdgeAlignedRight">
                                        <Grid RowDefinitions="Auto,*" Width="380" MaxHeight="420"
                                              DataContext="{Binding Activities}" x:DataType="vm:ActivityCenter">
                                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,10,8">
                                                <TextBlock Text="Activity" Classes="title" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Classes="ghost" Padding="8,4"
                                                        Command="{Binding ClearFinishedCommand}">
                                                    <TextBlock Text="Clear finished" FontSize="12" />
                                                </Button>
                                            </Grid>
                                            <ScrollViewer Grid.Row="1">
                                                <ItemsControl ItemsSource="{Binding Items}" Margin="8,0,8,10">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ActivityItem">
                                                            <Border CornerRadius="{StaticResource RadiusMedium}" Padding="10,9" Margin="0,2"
                                                                    Background="{DynamicResource SurfaceSunkenBrush}">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <ic:SymbolIcon Symbol="{Binding StateIcon}" FontSize="18"
                                                                                   VerticalAlignment="Top" Margin="0,1,10,0"
                                                                                   Classes="activity-state"
                                                                                   Classes.running="{Binding IsRunning}"
                                                                                   Classes.ok="{Binding IsSucceeded}"
                                                                                   Classes.bad="{Binding IsFailedState}" />
                                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <StackPanel Spacing="4" IsVisible="{Binding IsRunning}">
                                                                            <TextBlock Text="{Binding CurrentFileName}" Classes="caption"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                            <Grid ColumnDefinitions="*,Auto">
                                                                                <ProgressBar Classes="meter" Minimum="0" Maximum="1"
                                                                                             Value="{Binding Progress}"
                                                                                             IsIndeterminate="{Binding IsIndeterminate}"
                                                                                             VerticalAlignment="Center" />
                                                                                <TextBlock Grid.Column="1" Text="{Binding PercentText}"
                                                                                           Classes="caption" Margin="8,0,0,0" />
                                                                            </Grid>
                                                                            <TextBlock Text="{Binding StatusText}" Classes="caption"
                                                                                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding ResultText}" Classes="caption"
                                                                                   TextWrapping="Wrap" IsVisible="{Binding IsFinished}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                                                        <TextBlock Text="{Binding StartedText}" Classes="caption" />
                                                                        <Button Classes="ghost" Padding="4" HorizontalAlignment="Right"
                                                                                Command="{Binding CancelCommand}"
                                                                                IsVisible="{Binding IsRunning}" ToolTip.Tip="Cancel">
                                                                            <ic:SymbolIcon Symbol="Dismiss" FontSize="12" />
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <TextBlock Grid.Column="2" Text="{Binding SelectionText}"
                                       IsVisible="{Binding IsBrowserActive}"
                                       Classes="secondary" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Panel>
</Window>
