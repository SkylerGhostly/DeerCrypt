<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:vm="using:DeerCrypt.ViewModels.Dialogs"
        x:Class="DeerCrypt.Views.Dialogs.CreateVaultDialog"
        x:DataType="vm:CreateVaultViewModel"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="Create vault"
        Width="500"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="StackPanel.req ic|SymbolIcon.met">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="StackPanel.req ic|SymbolIcon.unmet">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="StackPanel.req TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <StackPanel>
        <StackPanel Margin="24,22,24,20" Spacing="18">
            <Grid ColumnDefinitions="Auto,*">
                <Border Classes="dialog-icon">
                    <ic:SymbolIcon Symbol="ShieldLock" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Create a vault" Classes="dialog-title" />
                    <TextBlock Text="Pick where to save it and set a strong password. There is no way to recover a lost password."
                               Classes="dialog-subtitle" />
                </StackPanel>
            </Grid>

            <StackPanel>
                <TextBlock Text="Save as" Classes="field-label" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Watermark="Choose a location" Text="{Binding VaultPath}"
                             IsReadOnly="True" Margin="0,0,8,0">
                        <TextBox.InnerLeftContent>
                            <ic:SymbolIcon Symbol="Document" Margin="10,0,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <Button Grid.Column="1" Classes="secondary" Content="Browse…" Command="{Binding BrowseCommand}" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Password" Classes="field-label" Margin="0" />
                <TextBox Watermark="Password" PasswordChar="●"
                         RevealPassword="{Binding ShowPassword}" Text="{Binding Password}">
                    <TextBox.InnerLeftContent>
                        <ic:SymbolIcon Symbol="Key" Margin="10,0,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                    </TextBox.InnerLeftContent>
                    <TextBox.InnerRightContent>
                        <ToggleButton Classes="ghost" Padding="6,4" Margin="0,0,4,0"
                                      IsChecked="{Binding ShowPassword}" ToolTip.Tip="Show or hide the password">
                            <ic:SymbolIcon Symbol="Eye" FontSize="15" />
                        </ToggleButton>
                    </TextBox.InnerRightContent>
                </TextBox>
                <TextBox Watermark="Confirm password" PasswordChar="●"
                         RevealPassword="{Binding ShowPassword}" Text="{Binding ConfirmPassword}">
                    <TextBox.InnerLeftContent>
                        <ic:SymbolIcon Symbol="Key" Margin="10,0,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <TextBlock Text="{Binding PasswordMatchText}"
                           Foreground="{Binding PasswordMatchBrush}"
                           FontSize="12"
                           IsVisible="{Binding ConfirmNotEmpty}" />
            </StackPanel>

            <!-- Strength -->
            <Border Classes="stat">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Password strength" Classes="caption" />
                        <TextBlock Grid.Column="1" Text="{Binding PasswordStrengthLabel}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{Binding PasswordStrengthBrush}" />
                    </Grid>
                    <ProgressBar Classes="meter" Value="{Binding PasswordStrengthPercent}" Maximum="100"
                                 Foreground="{Binding PasswordStrengthBrush}" />
                    <UniformGrid Columns="2" RowSpacing="6" ColumnSpacing="12">
                        <StackPanel Classes="req" Orientation="Horizontal" Spacing="6">
                            <Panel>
                                <ic:SymbolIcon Classes="met" Symbol="CheckmarkCircle" FontSize="14" IsVisible="{Binding PasswordHasLength}" />
                                <ic:SymbolIcon Classes="unmet" Symbol="Circle" FontSize="14" IsVisible="{Binding !PasswordHasLength}" />
                            </Panel>
                            <TextBlock Text="At least 8 characters" />
                        </StackPanel>
                        <StackPanel Classes="req" Orientation="Horizontal" Spacing="6">
                            <Panel>
                                <ic:SymbolIcon Classes="met" Symbol="CheckmarkCircle" FontSize="14" IsVisible="{Binding PasswordHasUpper}" />
                                <ic:SymbolIcon Classes="unmet" Symbol="Circle" FontSize="14" IsVisible="{Binding !PasswordHasUpper}" />
                            </Panel>
                            <TextBlock Text="An uppercase letter" />
                        </StackPanel>
                        <StackPanel Classes="req" Orientation="Horizontal" Spacing="6">
                            <Panel>
                                <ic:SymbolIcon Classes="met" Symbol="CheckmarkCircle" FontSize="14" IsVisible="{Binding PasswordHasDigit}" />
                                <ic:SymbolIcon Classes="unmet" Symbol="Circle" FontSize="14" IsVisible="{Binding !PasswordHasDigit}" />
                            </Panel>
                            <TextBlock Text="A number" />
                        </StackPanel>
                        <StackPanel Classes="req" Orientation="Horizontal" Spacing="6">
                            <Panel>
                                <ic:SymbolIcon Classes="met" Symbol="CheckmarkCircle" FontSize="14" IsVisible="{Binding PasswordHasSpecial}" />
                                <ic:SymbolIcon Classes="unmet" Symbol="Circle" FontSize="14" IsVisible="{Binding !PasswordHasSpecial}" />
                            </Panel>
                            <TextBlock Text="A symbol (!@#…)" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Classes="notice-error"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:SymbolIcon Symbol="ErrorCircle" FontSize="14" />
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="400" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="6" IsVisible="{Binding IsBusy}">
                <ProgressBar IsIndeterminate="True" Classes="meter" />
                <TextBlock Text="Creating the vault and deriving its key…" Classes="caption" />
            </StackPanel>
        </StackPanel>

        <Border Classes="dialog-footer">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="secondary" Content="Cancel" IsCancel="True" Click="OnCancelClicked" />
                <Button Classes="primary" Content="Create vault" IsDefault="True" Command="{Binding CreateCommand}" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
