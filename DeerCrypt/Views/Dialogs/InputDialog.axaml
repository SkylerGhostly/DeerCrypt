<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:vm="using:DeerCrypt.ViewModels.Dialogs"
        x:Class="DeerCrypt.Views.Dialogs.InputDialog"
        x:DataType="vm:InputDialogViewModel"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="{Binding Title}"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel>
        <StackPanel Margin="24,22,24,20" Spacing="16">
            <Grid ColumnDefinitions="Auto,*">
                <Border Classes="dialog-icon">
                    <ic:SymbolIcon Symbol="{Binding Icon}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Classes="dialog-title" />
                    <TextBlock Text="{Binding Prompt}" Classes="dialog-subtitle" />
                </StackPanel>
            </Grid>

            <StackPanel Spacing="8">
                <TextBox x:Name="InputBox"
                         Text="{Binding Value}"
                         Watermark="{Binding Placeholder}" />
                <Border Classes="notice-error"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:SymbolIcon Symbol="ErrorCircle" FontSize="14" />
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <Border Classes="dialog-footer">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="secondary" Content="Cancel" IsCancel="True" Click="OnCancelClicked" />
                <Button Classes="primary" Content="{Binding ConfirmText}"
                        Command="{Binding ConfirmCommand}" IsDefault="True" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
