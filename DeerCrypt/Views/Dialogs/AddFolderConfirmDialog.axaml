<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:vm="using:DeerCrypt.ViewModels.Dialogs"
        x:Class="DeerCrypt.Views.Dialogs.AddFolderConfirmDialog"
        x:DataType="vm:AddFolderConfirmViewModel"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="Add folder"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel>
        <StackPanel Margin="24,22,24,20" Spacing="16">
            <Grid ColumnDefinitions="Auto,*">
                <Border Classes="dialog-icon">
                    <ic:SymbolIcon Symbol="FolderArrowUp" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SummaryText}" Classes="dialog-title" />
                    <TextBlock Text="Everything inside is encrypted as it's added." Classes="dialog-subtitle" />
                </StackPanel>
            </Grid>

            <UniformGrid Columns="3" ColumnSpacing="8">
                <Border Classes="stat">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Files" Classes="caption" />
                        <TextBlock Text="{Binding FileCountText}" Classes="stat-value" />
                    </StackPanel>
                </Border>
                <Border Classes="stat">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Folders" Classes="caption" />
                        <TextBlock Text="{Binding FolderCountText}" Classes="stat-value" />
                    </StackPanel>
                </Border>
                <Border Classes="stat">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Size" Classes="caption" />
                        <TextBlock Text="{Binding SizeText}" Classes="stat-value" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <ic:SymbolIcon Symbol="Info" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="Folders with the same name are merged. Adding runs in the background."
                           Classes="caption" TextWrapping="Wrap" MaxWidth="380" />
            </StackPanel>
        </StackPanel>

        <Border Classes="dialog-footer">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="secondary" Content="Cancel" IsCancel="True" Click="OnCancelClicked" />
                <Button Classes="primary" Content="Add folder" IsDefault="True" Click="OnConfirmClicked" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
