<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="DeerCrypt.Views.Dialogs.OpenWithDialog"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="Open with"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel>
        <StackPanel Margin="24,22,24,20" Spacing="16">
            <Grid ColumnDefinitions="Auto,*">
                <Border Classes="dialog-icon">
                    <ic:SymbolIcon Symbol="Open" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Open with" Classes="dialog-title" />
                    <TextBlock x:Name="FileNameText" Classes="dialog-subtitle" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <UniformGrid Columns="2" ColumnSpacing="8" RowSpacing="8">
                <Button Classes="tile" Click="OnMediaPlayerClicked">
                    <StackPanel Spacing="6">
                        <ic:SymbolIcon Symbol="MusicNote2" FontSize="24" Foreground="#E0648A" HorizontalAlignment="Center" />
                        <TextBlock Text="Media player" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Plays straight from the vault" Classes="caption" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="tile" Click="OnImageViewerClicked">
                    <StackPanel Spacing="6">
                        <ic:SymbolIcon Symbol="Image" FontSize="24" Foreground="#3F9BDB" HorizontalAlignment="Center" />
                        <TextBlock Text="Image viewer" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Decrypted in memory" Classes="caption" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="tile" Click="OnTextEditorClicked">
                    <StackPanel Spacing="6">
                        <ic:SymbolIcon Symbol="DocumentText" FontSize="24" Foreground="#6F8FB5" HorizontalAlignment="Center" />
                        <TextBlock Text="Text editor" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Decrypted in memory" Classes="caption" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="tile" Click="OnExternalClicked">
                    <StackPanel Spacing="6">
                        <ic:SymbolIcon Symbol="Open" FontSize="24" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Another app" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Uses a temporary copy on disk" Classes="caption" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </StackPanel>

        <Border Classes="dialog-footer">
            <Button Classes="secondary" Content="Cancel" IsCancel="True" HorizontalAlignment="Right" Click="OnCancelClicked" />
        </Border>
    </StackPanel>
</Window>
