<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:vm="using:DeerCrypt.ViewModels.Dialogs"
        x:Class="DeerCrypt.Views.Dialogs.ConfirmDialog"
        x:DataType="vm:ConfirmDialogViewModel"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="{Binding Title}"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel>
        <Grid ColumnDefinitions="Auto,*" Margin="24,22,24,20">
            <Border Classes="dialog-icon"
                    Classes.danger="{Binding IsDanger}"
                    Classes.warning="{Binding IsWarning}"
                    Classes.success="{Binding IsSuccess}">
                <ic:SymbolIcon Symbol="{Binding Icon}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="6">
                <TextBlock Text="{Binding Message}" Classes="dialog-title" Margin="0,8,0,0" />
                <ScrollViewer MaxHeight="280" IsVisible="{Binding HasDetail}">
                    <SelectableTextBlock Text="{Binding Detail}"
                                         TextWrapping="Wrap"
                                         FontSize="13"
                                         Foreground="{DynamicResource TextSecondaryBrush}" />
                </ScrollViewer>
            </StackPanel>
        </Grid>

        <Border Classes="dialog-footer">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="secondary" Content="{Binding CancelText}"
                        IsVisible="{Binding HasCancel}" IsCancel="True"
                        Click="OnCancelClicked" />
                <Button Classes="secondary" Content="{Binding DiscardText}"
                        IsVisible="{Binding HasDiscard}"
                        Click="OnDiscardClicked" />
                <Button Classes="primary" Content="{Binding ConfirmText}"
                        IsVisible="{Binding !IsDanger}" IsDefault="True"
                        Click="OnConfirmClicked" />
                <Button Classes="danger" Content="{Binding ConfirmText}"
                        IsVisible="{Binding IsDanger}"
                        Click="OnConfirmClicked" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
