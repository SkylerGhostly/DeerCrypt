<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:vm="using:DeerCrypt.ViewModels.Dialogs"
        x:Class="DeerCrypt.Views.Dialogs.OpenVaultDialog"
        x:DataType="vm:OpenVaultViewModel"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="Open vault"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel>
        <StackPanel Margin="24,22,24,20" Spacing="18">
            <Grid ColumnDefinitions="Auto,*">
                <Border Classes="dialog-icon">
                    <ic:SymbolIcon Symbol="ShieldLock" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Unlock a vault" Classes="dialog-title" />
                    <TextBlock Text="Choose the vault file and enter its password." Classes="dialog-subtitle" />
                </StackPanel>
            </Grid>

            <StackPanel>
                <TextBlock Text="Vault file" Classes="field-label" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Watermark="/path/to/vault.dcv" Text="{Binding VaultPath}" Margin="0,0,8,0">
                        <TextBox.InnerLeftContent>
                            <ic:SymbolIcon Symbol="Document" Margin="10,0,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <Button Grid.Column="1" Classes="secondary" Content="Browse…" Command="{Binding BrowseCommand}" />
                </Grid>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Password" Classes="field-label" />
                <TextBox x:Name="PasswordBox"
                         Watermark="Vault password"
                         PasswordChar="●"
                         RevealPassword="{Binding ShowPassword}"
                         Text="{Binding Password}">
                    <TextBox.InnerLeftContent>
                        <ic:SymbolIcon Symbol="Key" Margin="10,0,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                    </TextBox.InnerLeftContent>
                    <TextBox.InnerRightContent>
                        <ToggleButton Classes="ghost" Padding="6,4" Margin="0,0,4,0"
                                      IsChecked="{Binding ShowPassword}"
                                      ToolTip.Tip="Show or hide the password">
                            <ic:SymbolIcon Symbol="Eye" FontSize="15" />
                        </ToggleButton>
                    </TextBox.InnerRightContent>
                </TextBox>
            </StackPanel>

            <Border Classes="notice-error"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:SymbolIcon Symbol="ErrorCircle" FontSize="14" />
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="380" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="6" IsVisible="{Binding IsBusy}">
                <ProgressBar IsIndeterminate="True" Classes="meter" />
                <TextBlock Text="Deriving the key from your password…" Classes="caption" />
            </StackPanel>
        </StackPanel>

        <Border Classes="dialog-footer">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="secondary" Content="Cancel" IsCancel="True" Click="OnCancelClicked" />
                <Button Classes="primary" IsDefault="True" Command="{Binding OpenCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="LockOpen" />
                        <TextBlock Text="Unlock" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
