<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:DeerCrypt.Converters"
             xmlns:viewers="using:DeerCrypt.ViewModels.Viewers"
             xmlns:viewerViews="using:DeerCrypt.Views.Viewers"
             x:Class="DeerCrypt.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme>
            <!--
                Accent is intentionally left unset so the OS accent color is used.
                RegionColor sets the base window color Fluent controls sit on.
            -->
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark"  RegionColor="#1B1B1E" />
                <ColorPaletteResources x:Key="Light" RegionColor="#FBFBFC" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="avares://DeerCrypt/Themes/Controls.axaml" />
    </Application.Styles>

    <!-- Each open document (tab or popped-out window) renders with its viewer -->
    <Application.DataTemplates>
        <DataTemplate DataType="viewers:ImageDocumentViewModel">
            <viewerViews:ImageViewerView />
        </DataTemplate>
        <DataTemplate DataType="viewers:MediaDocumentViewModel">
            <viewerViews:MediaPlayerView />
        </DataTemplate>
        <DataTemplate DataType="viewers:TextDocumentViewModel">
            <viewerViews:TextEditorView />
        </DataTemplate>
        <DataTemplate DataType="viewers:SettingsDocumentViewModel">
            <viewerViews:SettingsView />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DeerCrypt/Themes/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:VaultItemIconConverter x:Key="VaultItemIconConverter" />
            <converters:FileSizeConverter x:Key="FileSizeConverter" />
            <converters:BoolToHighlightConverter x:Key="BoolToHighlightConverter" />
        </ResourceDictionary>
    </Application.Resources>

</Application>
