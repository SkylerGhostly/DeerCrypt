<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        DeerCrypt design tokens.
        Every color the app paints comes from here so dark, light, and
        follow-system all work. The accent is never hardcoded: it is the
        OS accent color (SystemAccentColor) supplied by the Fluent theme.
    -->

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
            <!-- Surfaces: graphite, darkest at the edges, content slightly lifted -->
            <SolidColorBrush x:Key="AppBackgroundBrush"      Color="#1B1B1E" />
            <SolidColorBrush x:Key="ChromeBackgroundBrush"   Color="#151518" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush"      Color="#232327" />
            <SolidColorBrush x:Key="SurfaceSunkenBrush"      Color="#121214" />

            <!-- Lines -->
            <SolidColorBrush x:Key="HairlineBrush"           Color="#2A2A2F" />
            <SolidColorBrush x:Key="HairlineStrongBrush"     Color="#3A3A40" />

            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimaryBrush"        Color="#ECECEF" />
            <SolidColorBrush x:Key="TextSecondaryBrush"      Color="#A3A3AB" />
            <SolidColorBrush x:Key="TextMutedBrush"          Color="#6F6F78" />

            <!-- Interaction washes -->
            <SolidColorBrush x:Key="HoverBrush"              Color="#FFFFFF" Opacity="0.05" />
            <SolidColorBrush x:Key="PressedBrush"            Color="#FFFFFF" Opacity="0.08" />
            <SolidColorBrush x:Key="SelectedBrush"           Color="{DynamicResource SystemAccentColor}" Opacity="0.22" />
            <SolidColorBrush x:Key="SelectedHoverBrush"      Color="{DynamicResource SystemAccentColor}" Opacity="0.30" />
            <SolidColorBrush x:Key="DropTargetBrush"         Color="{DynamicResource SystemAccentColor}" Opacity="0.14" />

            <!-- Status -->
            <SolidColorBrush x:Key="DangerBrush"             Color="#F06A6A" />
            <SolidColorBrush x:Key="SuccessBrush"            Color="#5CC98A" />
            <SolidColorBrush x:Key="WarningBrush"            Color="#E8B44C" />
            <SolidColorBrush x:Key="DangerSoftBrush"         Color="#F06A6A" Opacity="0.16" />
            <SolidColorBrush x:Key="SuccessSoftBrush"        Color="#5CC98A" Opacity="0.16" />
            <SolidColorBrush x:Key="WarningSoftBrush"        Color="#E8B44C" Opacity="0.16" />
            <SolidColorBrush x:Key="DangerHoverBrush"        Color="#F48585" />

            <!-- Legacy keys still referenced by dialogs -->
            <SolidColorBrush x:Key="MainBackgroundBrush"     Color="#1B1B1E" />
            <SolidColorBrush x:Key="SeparatorBrush"          Color="#2A2A2F" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush"      Color="#FBFBFC" />
            <SolidColorBrush x:Key="ChromeBackgroundBrush"   Color="#F1F1F4" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush"      Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceSunkenBrush"      Color="#E9E9ED" />

            <SolidColorBrush x:Key="HairlineBrush"           Color="#E2E2E7" />
            <SolidColorBrush x:Key="HairlineStrongBrush"     Color="#CFCFD6" />

            <SolidColorBrush x:Key="TextPrimaryBrush"        Color="#1B1B1F" />
            <SolidColorBrush x:Key="TextSecondaryBrush"      Color="#5B5B64" />
            <SolidColorBrush x:Key="TextMutedBrush"          Color="#8C8C95" />

            <SolidColorBrush x:Key="HoverBrush"              Color="#000000" Opacity="0.045" />
            <SolidColorBrush x:Key="PressedBrush"            Color="#000000" Opacity="0.08" />
            <SolidColorBrush x:Key="SelectedBrush"           Color="{DynamicResource SystemAccentColor}" Opacity="0.16" />
            <SolidColorBrush x:Key="SelectedHoverBrush"      Color="{DynamicResource SystemAccentColor}" Opacity="0.24" />
            <SolidColorBrush x:Key="DropTargetBrush"         Color="{DynamicResource SystemAccentColor}" Opacity="0.12" />

            <SolidColorBrush x:Key="DangerBrush"             Color="#C93C3C" />
            <SolidColorBrush x:Key="SuccessBrush"            Color="#2E8B57" />
            <SolidColorBrush x:Key="WarningBrush"            Color="#B07A12" />
            <SolidColorBrush x:Key="DangerSoftBrush"         Color="#C93C3C" Opacity="0.12" />
            <SolidColorBrush x:Key="SuccessSoftBrush"        Color="#2E8B57" Opacity="0.12" />
            <SolidColorBrush x:Key="WarningSoftBrush"        Color="#B07A12" Opacity="0.14" />
            <SolidColorBrush x:Key="DangerHoverBrush"        Color="#B23030" />

            <SolidColorBrush x:Key="MainBackgroundBrush"     Color="#FBFBFC" />
            <SolidColorBrush x:Key="SeparatorBrush"          Color="#E2E2E7" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Accent as a brush (follows the OS accent live) -->
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource SystemAccentColor}" />

    <!-- Shape -->
    <CornerRadius x:Key="RadiusSmall">5</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">7</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">10</CornerRadius>

    <!-- Density: overwritten at runtime by ThemeService.ApplyDensity -->
    <Thickness x:Key="ListRowPadding">10,7</Thickness>
    <Thickness x:Key="NavItemPadding">10,6</Thickness>
    <x:Double x:Key="GridTileWidth">118</x:Double>
    <x:Double x:Key="GridTileHeight">124</x:Double>

</ResourceDictionary>
